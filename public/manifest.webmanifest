{
  "name": "CSV Map Maker",
  "short_name": "CSV Map",
  "description": "Free CSV map maker: paste or upload a CSV, auto-detect latitude and longitude columns, style markers by column, cluster points, show popups and export GeoJSON or PNG. Runs in your browser.",
